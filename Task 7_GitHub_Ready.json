    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this incoming email.\n\nSender:\n{{$json.sender}}\n\nSubject:\n{{$json.subject}}\n\nEmail Body:\n{{$json.body}}\n\nClassify this email into EXACTLY ONE category:\nspamm, Personal, Work, or draft.\n\nReturn ONLY valid JSON in this exact format:\n\n{\n  \"email_type\": \"spamm\",\n  \"reason\": \"short reason\",\n  \"draft_required\": false,\n  \"draft_response\": \"\"\n}\n\nRules:\n- spamm: suspicious, phishing, unsolicited marketing, or unwanted email\n- Personal: normal personal communication\n- Work: professional/work-related communication\n- draft: email that requires a reply\n- draft_required must be true ONLY when email_type is draft\n- If draft_required is false, draft_response must be an empty string\n- Always use \"spamm\" for the spam category. Never return \"spam\".\n- Do not add any extra fields.",
        "hasOutputParser": true,
        "options": {}
      },
